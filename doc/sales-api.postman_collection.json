{
  "info": {
    "name": "MoutsTI Sales API",
    "_postman_id": "mouts-sales-api-collection",
    "description": "Sales API collection for the MoutsTI backend challenge. Covers all `/api/sales` endpoints with success and representative error scenarios.\n\n**Base URLs**\n- Docker stack (API direct): `http://localhost:8080`\n- Docker stack (via frontend/nginx proxy): `http://localhost:4200`\n- Local dev (`ng serve` + proxy): `http://localhost:4200`\n\n**Variables** (edit in Postman/Insomnia environment):\n- `baseUrl` — default `http://localhost:8080`\n- `saleId` — set automatically after Create Sale\n- `itemId` — set automatically after Create Sale",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "saleId", "value": "" },
    { "key": "itemId", "value": "" },
    { "key": "customerId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "branchId", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "productId", "value": "33333333-3333-3333-3333-333333333333" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/swagger/index.html"
          }
        }
      ]
    },
    {
      "name": "Sales — Success",
      "item": [
        {
          "name": "Create Sale (5 units → 10% discount)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has sale data', () => pm.expect(json.data.id).to.be.a('string'));",
                  "pm.collectionVariables.set('saleId', json.data.id);",
                  "pm.collectionVariables.set('itemId', json.data.items[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"customerName\": \"John Doe\",\n  \"branchId\": \"{{branchId}}\",\n  \"branchName\": \"Downtown\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"productName\": \"Beer A\",\n      \"quantity\": 5,\n      \"unitPrice\": 10.00\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/sales"
          }
        },
        {
          "name": "Get Sale by Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Single data envelope (not double-wrapped)', () => {",
                  "  pm.expect(json.data).to.be.an('object');",
                  "  pm.expect(json.data.data).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/sales/{{saleId}}"
          }
        },
        {
          "name": "List Sales (pagination + filter + sort)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sales?_page=1&_size=10&customerName=John*&_order=saleDate desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales"],
              "query": [
                { "key": "_page", "value": "1" },
                { "key": "_size", "value": "10" },
                { "key": "customerName", "value": "John*" },
                { "key": "_order", "value": "saleDate desc" }
              ]
            }
          }
        },
        {
          "name": "Update Sale (10 units → 20% discount)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"customerName\": \"John Updated\",\n  \"branchId\": \"{{branchId}}\",\n  \"branchName\": \"Downtown\",\n  \"saleDate\": \"2026-07-12T12:00:00Z\",\n  \"items\": [\n    {\n      \"id\": \"{{itemId}}\",\n      \"productId\": \"{{productId}}\",\n      \"productName\": \"Beer A\",\n      \"quantity\": 10,\n      \"unitPrice\": 10.00\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/sales/{{saleId}}"
          }
        },
        {
          "name": "Cancel Sale Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/sales/{{saleId}}/items/{{itemId}}/cancel"
          }
        },
        {
          "name": "Cancel Sale",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/sales/{{saleId}}/cancel"
          }
        },
        {
          "name": "Delete Sale",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/sales/{{saleId}}"
          }
        }
      ]
    },
    {
      "name": "Sales — Error cases",
      "item": [
        {
          "name": "Create Sale — quantity > 20 (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "const json = pm.response.json();",
                  "pm.test('Error envelope', () => {",
                  "  pm.expect(json.type).to.eql('ValidationError');",
                  "  pm.expect(json.detail).to.include('20');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"customerName\": \"Error Test\",\n  \"branchId\": \"{{branchId}}\",\n  \"branchName\": \"Downtown\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"productName\": \"Beer X\",\n      \"quantity\": 21,\n      \"unitPrice\": 1.00\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/sales"
          }
        },
        {
          "name": "Get Sale — not found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/sales/00000000-0000-0000-0000-000000000099"
          }
        },
        {
          "name": "Create Sale — empty items (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"customerName\": \"No Items\",\n  \"branchId\": \"{{branchId}}\",\n  \"branchName\": \"Downtown\",\n  \"items\": []\n}"
            },
            "url": "{{baseUrl}}/api/sales"
          }
        },
        {
          "name": "Cancel Sale — already cancelled (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/sales/{{saleId}}/cancel"
          }
        }
      ]
    }
  ]
}
