# Copy this file to ".env" (same folder) and adjust values as needed.
# ".env" is git-ignored and must never be committed.

# PostgreSQL (ambev.developerevaluation.database)
POSTGRES_DB=developer_evaluation
POSTGRES_USER=developer
POSTGRES_PASSWORD=ev@luAt10n

# Redis (ambev.developerevaluation.cache)
REDIS_PASSWORD=ev@luAt10n

# JWT signing key used by the WebApi (must be at least 32 bytes long)
JWT_SECRET_KEY=YourSuperSecretKeyForJwtTokenGenerationThatShouldBeAtLeast32BytesLong
